[Unit]
Description=cyberGAU web, API and database
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/cybergau
Environment=COMPOSE_BAKE=false
ExecStart=/usr/bin/docker compose --env-file /opt/cybergau/.env up -d --build
ExecStop=/usr/bin/docker compose --env-file /opt/cybergau/.env down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
