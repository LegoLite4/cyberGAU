[Unit]
Description=cyberGAU web, API and database
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/cybergau
Environment=COMPOSE_BAKE=false
# --force-recreate api: иначе после смены .env (ключи панели) API остаётся со старыми пустыми env.
ExecStart=/bin/bash -c 'docker compose --env-file /opt/cybergau/.env up -d && docker compose --env-file /opt/cybergau/.env up -d --force-recreate --no-deps api'
ExecStop=/usr/bin/docker compose --env-file /opt/cybergau/.env down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
