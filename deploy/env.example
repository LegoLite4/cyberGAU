# Скопируйте в /etc/cybergau/env и замените пароли.
# Тестовая VM: CYBERGAU_ACCESS=wireguard
# Основной ПК: CYBERGAU_ACCESS=lan и свой LAN-адрес в ADVERTISE_HOST / BIND_ADDR / PUBLIC_WEB_URL

CYBERGAU_ACCESS=wireguard
CYBERGAU_REPO=git@github.com:LegoLite4/cyberGAU.git
INSTALL_PTERODACTYL=1
POOL_SIZE=1

POSTGRES_USER=cybergau
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cybergau
DATABASE_URL=postgresql://cybergau:change-me@postgres:5432/cybergau

PUBLIC_WEB_URL=http://10.77.0.1:3000
ADVERTISE_HOST=10.77.0.1
BIND_ADDR=10.77.0.1
WEB_PORT=3000
COOKIE_SECURE=0

STEAM_WEB_API_KEY=
STEAM_GSLT=
PTERODACTYL_MOCK=0
PTERODACTYL_URL=http://10.77.0.1:8088
PTERODACTYL_APP_KEY=
PTERODACTYL_CLIENT_KEY=
PTERODACTYL_DOCKER_IMAGE=ghcr.io/ptero-eggs/steamcmd:sniper

WG_ENDPOINT=203.0.113.10:51820
PANEL_PORT=8088
PANEL_FQDN=10.77.0.1
ALLOC_IP=10.77.0.1
CS2_MEMORY_MB=2048
CS2_DISK_MB=40960
CS2_CPU=200

ADMIN_EMAIL=admin@cybergau.local
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-admin
PANEL_DB_PASSWORD=change-me-panel
TZ=Europe/Moscow
