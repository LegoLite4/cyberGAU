# Скопируйте в /etc/cybergau/env и замените пароли.
# По умолчанию lan: адреса берутся с основного интерфейса (192.168.x / 10.x / …).
# Для VPN-теста: CYBERGAU_ACCESS=wireguard и WG_ENDPOINT=публичный_ip:51820

CYBERGAU_ACCESS=lan
CYBERGAU_REPO=https://github.com/LegoLite4/cyberGAU.git
INSTALL_PTERODACTYL=1
POOL_SIZE=1

POSTGRES_USER=cybergau
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cybergau
DATABASE_URL=postgresql://cybergau:change-me@postgres:5432/cybergau

# При ручной правке подставьте свой LAN-IP. write-env.sh подставит его сам.
PUBLIC_WEB_URL=http://192.168.0.10:3000
ADVERTISE_HOST=192.168.0.10
BIND_ADDR=192.168.0.10
WEB_PORT=3000
COOKIE_SECURE=0

STEAM_WEB_API_KEY=
STEAM_GSLT=
PTERODACTYL_MOCK=0
PTERODACTYL_URL=http://192.168.0.10:8088
PTERODACTYL_APP_KEY=
PTERODACTYL_CLIENT_KEY=
PTERODACTYL_DOCKER_IMAGE=ghcr.io/ptero-eggs/steamcmd:sniper

WG_ENDPOINT=203.0.113.10:51820
PANEL_PORT=8088
PANEL_FQDN=192.168.0.10
ALLOC_IP=192.168.0.10
CS2_MEMORY_MB=2048
CS2_DISK_MB=90000
CS2_CPU=200

ADMIN_EMAIL=admin@cybergau.local
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-admin
PANEL_DB_PASSWORD=change-me-panel
TZ=Europe/Moscow
